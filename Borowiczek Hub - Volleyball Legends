local function collectBallParts()
    local parts = {}

    pcall(function()
        local ballFolder = getBallFolder()
        if not ballFolder then
            return
        end

        for _, instance in ballFolder:GetDescendants() do
            if isBallPart(instance) then
                parts[#parts + 1] = instance
            end
        end

        for _, child in ballFolder:GetChildren() do
            if isBallPart(child) then
                parts[#parts + 1] = child
            end
        end
    end)

    return parts
end

local function expandBalls()
    local count = 0
    local newSize = Vector3.new(BallSize, BallSize, BallSize)

    for _, part in collectBallParts() do
        pcall(function()
            local key = partKey(part)
            if OriginalSizes[key] == nil then
                OriginalSizes[key] = part.Size
            end

            part.Size = newSize
            count = count + 1
        end)
    end

    LastCount = count
    return count
end

local function restoreBalls()
    local restored = 0

    for _, part in collectBallParts() do
        pcall(function()
            local savedSize = OriginalSizes[partKey(part)]
            if savedSize then
                part.Size = savedSize
                restored = restored + 1
            end
        end)
    end

    LastCount = restored
    return restored
end

