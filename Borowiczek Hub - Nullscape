local function keepAliveCache(newCache, oldCache)
    if #newCache > 0 or #oldCache <= 0 then
        return newCache
    end

    local alive = {}
    for _, object in ipairs(oldCache) do
        if objectAlive(object) then
            alive[#alive + 1] = object
        end
    end

    return alive
end

local function refreshObjectCache(force)
