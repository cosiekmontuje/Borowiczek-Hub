local function getPartCorners(part)
    if not part or not part.Position or not part.Size then
        return nil
    end

    local half = part.Size / 2
    local offsets = {
        Vector3.new(-half.X, -half.Y, -half.Z),
        Vector3.new(-half.X, -half.Y, half.Z),
        Vector3.new(-half.X, half.Y, -half.Z),
        Vector3.new(-half.X, half.Y, half.Z),
        Vector3.new(half.X, -half.Y, -half.Z),
        Vector3.new(half.X, -half.Y, half.Z),
        Vector3.new(half.X, half.Y, -half.Z),
        Vector3.new(half.X, half.Y, half.Z),
    }

    local corners = {}
    for index, offset in ipairs(offsets) do
        local ok, corner = pcall(function()
            return part.CFrame * offset
        end)

        corners[index] = ok and corner or (part.Position + offset)
    end

    return corners
end

local function renderWireHitbox(wire, part)
    if not wire or not part then
        hideWireHitbox(wire)
        return
    end

    local corners = getPartCorners(part)
    if not corners then
        hideWireHitbox(wire)
        return
    end

    local screenCorners = {}
    for index, corner in ipairs(corners) do
        local screen = projectPosition(corner)
        if not screen then
            hideWireHitbox(wire)
            return
        end
        screenCorners[index] = Vector2.new(screenX(screen), screenY(screen))
    end

    for index, edge in ipairs(WireBoxEdges) do
        local line = wire.lines[index]
        if line then
            line.From = screenCorners[edge[1]]
            line.To = screenCorners[edge[2]]
            line.Visible = true
        end
    end

    local top = screenCorners[7]
    for _, point in ipairs(screenCorners) do
        if point.Y < top.Y then
            top = point
        end
    end

    wire.name.Position = Vector2.new(top.X, top.Y - 14)
    wire.name.Visible = true
end

