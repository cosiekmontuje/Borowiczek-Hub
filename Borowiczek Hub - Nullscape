local function getBoundingBox(object)
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local found = false

    for _, part in ipairs(getCachedParts(object)) do
        local position = part.Position
        local size = part.Size

        if position and size then
            local half = size / 2
            local offsets = {
                Vector3.new(-half.X, -half.Y, -half.Z),
                Vector3.new(-half.X, -half.Y, half.Z),
                Vector3.new(-half.X, half.Y, -half.Z),
                Vector3.new(-half.X, half.Y, half.Z),
                Vector3.new(half.X, -half.Y, -half.Z),
                Vector3.new(half.X, -half.Y, half.Z),
                Vector3.new(half.X, half.Y, -half.Z),
                Vector3.new(half.X, half.Y, half.Z),
            }

            for _, offset in ipairs(offsets) do
                local screen, visible = projectPosition(position + offset)
                if screen and visible then
                    local x = screenX(screen)
                    local y = screenY(screen)
                    found = true
                    minX = math.min(minX, x)
                    minY = math.min(minY, y)
                    maxX = math.max(maxX, x)
                    maxY = math.max(maxY, y)
                end
            end
        end
    end

    if found then
        return true, minX, minY, maxX - minX, maxY - minY
    end

    return false, 0, 0, 0, 0
end

local function renderBoundingBox(box, object)
    local found, x, y, w, h = getBoundingBox(object)

    if not box or not found or w <= 1 or h <= 1 then
        hideBellBox(box)
