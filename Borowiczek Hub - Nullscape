local function getAntiVoidThreshold()
    local killVoidPosition = getChildPosition(Workspace, kJmtybCbjx({'***************************************************************************','*********************************************************************************************************','************************************************************************************************************','************************************************************************************************************','**************************************************************************************','***************************************************************************************************************','*********************************************************************************************************','****************************************************************************************************'}))
    if killVoidPosition then
        return killVoidPosition.Y + 75
    end

    return -50
end

local function saveAntiVoidSafePoint(root)
    local now = tick()
    if root and root.CFrame and root.Position and root.Position.Y > getAntiVoidThreshold() + 25 and now - LastAntiVoidSave > 2 then
        AntiVoidSafeCFrame = root.CFrame
        LastAntiVoidSave = now
    end
end

local function runAntiVoid()
    if not AntiVoidEnabled then
        return
    end

    local root = getLocalRoot()
    if not root or not root.Position then
        return
    end

    saveAntiVoidSafePoint(root)

    if root.Position.Y > getAntiVoidThreshold() then
        return
    end

    if AntiVoidMode == kJmtybCbjx({'****************************************************************************','*************************************************************************************************','*********************************************************************************************************************','**************************************************************************************************************','***************************************************************************************************','********************************************************************************************************','********************************','*************************************************************************************','****************************************************************************************************************'}) then
        local launched = pcall(function()
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(velocity.X, AntiVoidLaunchPower, velocity.Z)
        end)

        if launched then
            return
        end
    end

    local safeCFrame = getAntiVoidSpawnCFrame()
    if safeCFrame then
        pcall(function()
            root.CFrame = safeCFrame
        end)
    else
        pcall(function()
            root.CFrame = root.CFrame + Vector3.new(0, math.clamp(AntiVoidLaunchPower / 10, 20, 80), 0)
        end)
    end
end

local function reapplyPersistentOptions()
    refreshObjectCache(true)

    if FovValue then
        pcall(function()
            local camera = Workspace.CurrentCamera
            if camera then
                camera.FieldOfView = FovValue
            end
        end)
    end

    local root = getLocalRoot()
    if root and root.CFrame then
        AntiVoidSafeCFrame = root.CFrame
        LastAntiVoidSave = tick()
    end

    if TripmineEspEnabled then updateTripmineEsp() end
    if BellEspEnabled then updateBellEsp() end
    if MartEspEnabled then updateMartEsp() end
    if HuskEspEnabled then updateHuskEsp() end
    if TelefraggerEspEnabled then updateTelefraggerEsp() end
    if FleshEspEnabled then updateFleshEsp() end
    if BabyEspEnabled then updateBabyEsp() end
    if PlayerHitboxEnabled then updatePlayerHitbox() end
    if VelocityVisualizerEnabled then updateVelocityVisualizer() end
end

