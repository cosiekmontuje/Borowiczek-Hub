local function renderStaticBox(box, position)
    local screen, visible = projectPosition(position)

    if not box or not screen or not visible then
        hideBellBox(box)
        return
    end

    local x = screenX(screen) - StaticBoxSize.X / 2
    local y = screenY(screen) - StaticBoxSize.Y / 2
    local w = StaticBoxSize.X
    local h = StaticBoxSize.Y

    box.outline1.Position = Vector2.new(x + 1, y + 1)
    box.outline1.Size = Vector2.new(w - 2, h - 2)
    box.outline1.Visible = true

    box.outline2.Position = Vector2.new(x - 1, y - 1)
    box.outline2.Size = Vector2.new(w + 2, h + 2)
    box.outline2.Visible = true

    box.main.Position = Vector2.new(x, y)
    box.main.Size = Vector2.new(w, h)
    box.main.Visible = true

    box.name.Position = Vector2.new(x + w / 2, y - 16)
    box.name.Visible = true

    if box.tracer then
        if EnemyTracersEnabled then
            box.tracer.From = getTracerOrigin()
            box.tracer.To = Vector2.new(x + w / 2, y + h / 2)
            box.tracer.Visible = true
        else
            box.tracer.Visible = false
        end
    end
end

local function getBoundingBox(object)
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local found = false

    for _, part in ipairs(getCachedParts(object)) do
        local position = part.Position
        local size = part.Size

        if position and size then
            local half = size / 2
            local offsets = {
                Vector3.new(-half.X, -half.Y, -half.Z),
                Vector3.new(half.X, half.Y, half.Z),
                Vector3.new(-half.X, half.Y, -half.Z),
                Vector3.new(half.X, -half.Y, half.Z),
            }

            for _, offset in ipairs(offsets) do
                local screen, visible = projectPosition(position + offset)
                if screen and visible then
                    local x = screenX(screen)
                    local y = screenY(screen)
                    found = true
                    minX = math.min(minX, x)
                    minY = math.min(minY, y)
                    maxX = math.max(maxX, x)
                    maxY = math.max(maxY, y)
                end
            end
        end
    end

    if found then
        return true, minX, minY, maxX - minX, maxY - minY
    end

    return false, 0, 0, 0, 0
end

