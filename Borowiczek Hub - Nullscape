local function getCameraMoveDirection()
    local camera = Workspace.CurrentCamera
    if not camera or not camera.CFrame then
        return nil
    end

    local forward = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector
    forward = Vector3.new(forward.X, 0, forward.Z)
    right = Vector3.new(right.X, 0, right.Z)

    if forward.Magnitude > 0 then
        forward = forward.Unit
    end

    if right.Magnitude > 0 then
        right = right.Unit
    end

    local direction = Vector3.new(0, 0, 0)

    if type(iskeypressed) == kJmtybCbjx({'******************************************************************************************************','*********************************************************************************************************************','**************************************************************************************************************','***************************************************************************************************','********************************************************************************************************************','*********************************************************************************************************','***************************************************************************************************************','**************************************************************************************************************'}) then
        if iskeypressed(0x57) then direction = direction + forward end -- W
        if iskeypressed(0x53) then direction = direction - forward end -- S
        if iskeypressed(0x44) then direction = direction + right end -- D
        if iskeypressed(0x41) then direction = direction - right end -- A
    end

    if direction.Magnitude <= 0 then
        return nil
    end

    return direction.Unit
end

