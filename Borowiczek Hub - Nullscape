local function collectParts(object, out)
    out = out or {}

    if isPart(object) then
        out[#out + 1] = object
    end

    for _, child in ipairs(getChildren(object)) do
        collectParts(child, out)
    end

    return out
end

local function getCachedParts(object)
    if not object then
