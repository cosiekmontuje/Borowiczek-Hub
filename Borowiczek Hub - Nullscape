local function updateVelocityVisualizer()
    local line = getVelocityLine()
    if not line then
        return
    end

    if not VelocityVisualizerEnabled then
        line.Visible = false
        return
    end

    local root = getLocalRoot()
    if not root or not root.Position then
        line.Visible = false
        return
    end

    local ok, velocity = pcall(function()
        return root.AssemblyLinearVelocity
    end)

    if not ok or not velocity or velocity.Magnitude <= 1 then
        line.Visible = false
        return
    end

    local direction = Vector3.new(velocity.X, velocity.Y * 0.5, velocity.Z)
    if direction.Magnitude <= 1 then
        line.Visible = false
        return
    end

    local length = math.clamp(direction.Magnitude * 0.35, 4, 80)
    local startPosition = root.Position
    local endPosition = startPosition + direction.Unit * length
    local startScreen, startVisible = projectPosition(startPosition)
    local endScreen, endVisible = projectPosition(endPosition)

    if startScreen and endScreen and startVisible and endVisible then
        local t = math.clamp(direction.Magnitude / 80, 0, 1)
        line.From = Vector2.new(screenX(startScreen), screenY(startScreen))
        line.To = Vector2.new(screenX(endScreen), screenY(endScreen))
        line.Color = Color3.fromRGB(255, math.floor(255 * (1 - t)), math.floor(255 * (1 - t)))
        line.Visible = true
    else
        line.Visible = false
    end
end

